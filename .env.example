# Environment variable names used by Ironclad's tools. The game itself reads none.
# Values are blank on purpose: the real App Store Connect key lives only in Codemagic (group ios_credentials).

# App Store Connect API key (Tools/appstore/iap.py, listing.py, gamecenter.py, capabilities.py)
APP_STORE_CONNECT_KEY_IDENTIFIER=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_PRIVATE_KEY=

# Where docs/appstore/... is read from (a path or URL; defaults to this checkout)
LISTING_BASE=
# The purchase review screenshot (a path or URL; defaults to docs/appstore/iap_review.png on GitHub)
IAP_SCREENSHOT=

# Font Awesome Solid .ttf for Tools/art/gc_badges.py and coach_art.py
FA_SOLID=
# A .NET 8 SDK dotnet binary for Tools/core-test.sh
DOTNET=
